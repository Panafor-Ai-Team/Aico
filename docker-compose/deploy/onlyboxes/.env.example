# Copy to .env (chmod 600). Secrets: generate each with `openssl rand -hex 32`.

# Pin by digest after `docker pull` (docker inspect -f '{{index .RepoDigests 0}}').
ONLYBOXES_CONSOLE_IMAGE=coolfan1024/onlyboxes:0.14.1@sha256:b0a1fe04a09772ecbece0a8cc0c7f63ef8bbc7bd298bb44752f30d788cea869f

# Gateway of panachat-network:
# docker network inspect panachat-network -f '{{(index .IPAM.Config 0).Gateway}}'
ONLYBOXES_APP_BIND_IP=172.18.0.1

CONSOLE_HASH_KEY=replace-with-random-hex
# Must equal ONLYBOXES_JIT_SIGNING_KEY in the app's repo-root .env.
CONSOLE_JIT_SIGNING_KEY=replace-with-random-hex

# Used only on the first start, when the SQLite DB is empty.
CONSOLE_DASHBOARD_USERNAME=admin
CONSOLE_DASHBOARD_PASSWORD=replace-with-random-hex
