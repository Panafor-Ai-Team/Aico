# Install as /etc/onlyboxes/worker.env (root:root, chmod 600).
# Budget for 5 concurrent sandboxes on the 4 vCPU / 7.75 GiB production host:
# 5 x (512 MiB, 0.5 CPU, 256 pids), swap forced to 0 by onlyboxes-guard.

# Identity, from the console "Create worker" dialog (secret is shown once).
WORKER_ID=replace-me
WORKER_SECRET=replace-me
WORKER_NODE_NAME=parspack-teh-1

# Console runs on the same host; gRPC is bound to loopback only.
WORKER_CONSOLE_GRPC_TARGET=127.0.0.1:50051
WORKER_CONSOLE_INSECURE=true

# Sandbox network, created by sandbox-firewall.sh (bridge, ICC off).
WORKER_DOCKER_NETWORK=onlyboxes-sandbox

# terminalExec: one container per LobeHub (user, topic) session.
WORKER_TERMINAL_EXEC_DOCKER_IMAGE=coolfan1024/onlyboxes-runtime:0.14.1-lobehub@sha256:e8b6e21d4d2c27657cc4c29d4f9ec8de81e5d9ad0ef6ae951b0d5cb1e7176750
WORKER_TERMINAL_EXEC_MEMORY_MIB=512
WORKER_TERMINAL_EXEC_CPUS=0.5
WORKER_TERMINAL_EXEC_MAX_PROCESSES=256
WORKER_TERMINAL_MAX_ACTIVE_SESSIONS=5
# LobeHub runs a step's tool calls in parallel on the same session.
WORKER_TERMINAL_SESSION_MAX_INFLIGHT=4
WORKER_TERMINAL_EXEC_MAX_INFLIGHT=10
WORKER_TERMINAL_RESOURCE_MAX_INFLIGHT=4
WORKER_TERMINAL_LEASE_MIN_SEC=60
WORKER_TERMINAL_LEASE_MAX_SEC=1800
WORKER_TERMINAL_LEASE_DEFAULT_SEC=900
WORKER_TERMINAL_OUTPUT_LIMIT_BYTES=1048576
WORKER_TERMINAL_EXPORT_MAX_BYTES=1073741824

# pythonExec is not used by LobeHub; keep it to one small container.
WORKER_PYTHON_EXEC_DOCKER_IMAGE=coolfan1024/onlyboxes-runtime:0.14.1-lobehub@sha256:e8b6e21d4d2c27657cc4c29d4f9ec8de81e5d9ad0ef6ae951b0d5cb1e7176750
WORKER_PYTHON_EXEC_MEMORY_MIB=256
WORKER_PYTHON_EXEC_CPUS=0.25
WORKER_PYTHON_EXEC_MAX_PROCESSES=128
WORKER_PYTHON_EXEC_MAX_INFLIGHT=1
WORKER_ECHO_MAX_INFLIGHT=1

WORKER_LOG_LEVEL=info
WORKER_LOG_FORMAT=json
